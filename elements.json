[
  {
    "name": "from_input",
    "xpath": "//input[@placeholder='Откуда']",
    "stage": "search_form",
    "action_before": null,
    "notes": "Поле «Откуда»",
    "fallbacks": [
      "input[placeholder*=\"Откуда\" i]",
      "[aria-label*=\"Откуда\" i] input",
      "xpath=//label[contains(.,\"Откуда\")]//input"
    ]
  },
  {
    "name": "to_input",
    "xpath": "//input[@placeholder='Куда']",
    "stage": "search_form",
    "action_before": null,
    "notes": "Поле «Куда»",
    "fallbacks": [
      "input[placeholder=\"Куда\" i]",
      "[aria-label=\"Куда\" i] input",
      "xpath=//label[normalize-space(.)=\"Куда\"]//input"
    ]
  },
  {
    "name": "suggest_items",
    "xpath": "//div[contains(@class,'dropdown-item')]",
    "stage": "from_dropdown",
    "action_before": null,
    "inline_only": true,
    "notes": "Подсказки городов — проверяется inline в fill_from_input до клика по подсказке"
  },
  {
    "name": "calendar_open_btn",
    "xpath": "//input[@placeholder='Туда']",
    "stage": "search_form",
    "action_before": null,
    "notes": "Клик открывает календарь",
    "fallbacks": [
      "input[placeholder=\"Туда\" i]",
      "[aria-label*=\"Туда\" i] input"
    ]
  },
  {
    "name": "return_input",
    "xpath": "//input[@placeholder='Обратно']",
    "stage": "search_form",
    "action_before": null,
    "fallbacks": [
      "input[placeholder=\"Обратно\" i]",
      "[aria-label*=\"Обратно\" i] input"
    ],
    "notes": "Поле «Обратно» (дата возврата)"
  },
  {
    "name": "calendar_month_spans",
    "xpath": "//*[not(*) and (normalize-space()='Январь' or normalize-space()='Февраль' or normalize-space()='Март' or normalize-space()='Апрель' or normalize-space()='Май' or normalize-space()='Июнь' or normalize-space()='Июль' or normalize-space()='Август' or normalize-space()='Сентябрь' or normalize-space()='Октябрь' or normalize-space()='Ноябрь' or normalize-space()='Декабрь')]",
    "stage": "calendar",
    "action_before": "open_calendar",
    "notes": "Названия месяцев в календаре (боковой список и заголовки панелей)",
    "fallbacks": [
      "text=/^(январь|февраль|март|апрель|май|июнь|июль|август|сентябрь|октябрь|ноябрь|декабрь)$/i"
    ]
  },
  {
    "name": "calendar_day_buttons",
    "xpath": "//button[translate(normalize-space(text()[1]),'0123456789','')='' and normalize-space(text()[1])!='']",
    "stage": "calendar",
    "action_before": "open_calendar",
    "notes": "Кнопки-дни в открытом календаре (текст — число месяца)"
  },
  {
    "name": "search_btn",
    "xpath": "//button[normalize-space(.)='Найти']",
    "stage": "search_form",
    "action_before": "select_date",
    "notes": "Кнопка «Найти»",
    "fallbacks": [
      "role=button[name=\"Найти\"]",
      "button:has-text(\"Найти\")"
    ]
  },
  {
    "name": "no_flights_message",
    "xpath": "/html/body/div/div[2]/div/div/div/div/div/div[3]/div/div/div[3]/div/div[3]/div[2]/h3",
    "stage": "results_branch_empty",
    "action_before": "click_search",
    "notes": "Появляется, если рейсов нет — альтернативная ветка к results_ready"
  },
  {
    "name": "results_ready_indicator",
    "xpath": "//button[.//p[normalize-space(.)='Эконом']]//p[starts-with(normalize-space(.), 'от') and contains(., '₽')]",
    "stage": "results_branch_flights",
    "action_before": "click_search",
    "notes": "Индикатор, что результаты подгрузились",
    "fallbacks": [
      "text=/от\\s*[\\d\\s ]+₽/"
    ]
  },
  {
    "name": "click_after_results_1",
    "xpath": "(//button[.//p[normalize-space(.)='Эконом']])[1]",
    "stage": "results_flow_1",
    "action_before": "wait_results_ready",
    "notes": "Клик по первому результату — ветка 1",
    "fallbacks": [
      "button:has-text(\"Эконом\") >> nth=0"
    ]
  },
  {
    "name": "price_1a_econom_basic",
    "xpath": "//div[@role='listitem'][.//p[normalize-space()='Эконом Базовый']]//p[contains(text(),'₽')]",
    "stage": "results_flow_1",
    "action_before": "click_after_results_1",
    "notes": "Цена «Эконом Базовый», ветка 1"
  },
  {
    "name": "price_1b_econom_optimum",
    "xpath": "//div[@role='listitem'][.//p[normalize-space()='Эконом Оптимум']]//p[contains(text(),'₽')]",
    "stage": "results_flow_1",
    "action_before": "click_after_results_1",
    "notes": "Цена «Эконом Оптимум», ветка 1"
  },
  {
    "name": "open_result2_panel",
    "xpath": "//div[@role='listitem'][.//p[normalize-space()='Эконом Базовый']]//button",
    "stage": "results_flow_2",
    "action_before": "wait_results_ready",
    "notes": "Открытие альтернативной панели тарифов — ветка 2"
  },
  {
    "name": "click_result2_button",
    "xpath": "(//button[.//p[normalize-space(.)='Эконом']])[1]",
    "stage": "results_flow_2",
    "action_before": "open_result2_panel",
    "notes": "Клик для раскрытия деталей — ветка 2",
    "fallbacks": [
      "button:has-text(\"Эконом\") >> nth=0"
    ]
  },
  {
    "name": "price_2a_econom_basic",
    "xpath": "(//div[@role='listitem'][.//p[normalize-space()='Эконом Базовый']]//p[contains(text(),'₽')])[1]",
    "stage": "results_flow_2",
    "action_before": "click_result2_button",
    "notes": "Цена «Эконом Базовый», ветка 2"
  },
  {
    "name": "price_2b_econom_optimum",
    "xpath": "(//div[@role='listitem'][.//p[normalize-space()='Эконом Оптимум']]//p[contains(text(),'₽')])[1]",
    "stage": "results_flow_2",
    "action_before": "click_result2_button",
    "notes": "Цена «Эконом Оптимум», ветка 2"
  },
  {
    "name": "popup_ok_btn",
    "xpath": "//button[.//span[normalize-space()='Хорошо'] or normalize-space()='Хорошо']",
    "stage": "global_popup",
    "action_before": null,
    "optional": true,
    "notes": "Может появиться в любой момент, нужно проверять/закрывать перед остальными шагами"
  },
  {
    "name": "something_went_wrong_title",
    "xpath": "//*[self::h2 or self::h3][contains(normalize-space(), 'Что-то пошло не так')]",
    "stage": "global_error",
    "action_before": null,
    "optional": true,
    "notes": "Признак ошибки на странице"
  },
  {
    "name": "something_went_wrong_box",
    "xpath": "/html/body/div/div[2]/div/div/div/div[1]/div[1]/div[1]",
    "stage": "global_error",
    "action_before": null,
    "optional": true,
    "notes": "Контейнер блока ошибки"
  }
]
